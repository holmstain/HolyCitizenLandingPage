# ============================================================
# HolyCitizen — Tüm servisler için ortak ortam değişkenleri
# ============================================================
# Bu dosyayı kopyalayarak .env oluşturun, ardından her bot klasöründeki
# .env.example'ını da kendi .env dosyanıza kopyalayıp doldurun.
# Asla GERÇEK token/secret değerlerini depoya commitlemeyin.

# --- Discord Botu (HolyCitizenDCBot/.env) ---
# DISCORD_TOKEN=your-discord-bot-token
# CLIENT_ID=your-discord-application-id
# GUILD_SETTINGS='{"<guild-id>":{"autoRoleId":"<role-id>"...}}'
# AUTO_ROLE_ID=
# SUPPORT_ROLE_ID=
# APPLICATION_REVIEW_CHANNEL_ID=
# APPROVED_ROLE_ID=
# RAID_JOIN_THRESHOLD=5
# RAID_WINDOW_MS=10000

# --- Kick Botu (HolyCitizenKickChatBot/.env) ---
# KICK_CLIENT_ID=your-kick-client-id
# KICK_CLIENT_SECRET=your-kick-client-secret
# PUBLIC_BASE_URL=https://alanadiniz.com
# HOST=0.0.0.0
# PORT=8000
# DATABASE_PATH=/data/holycitizen.db
# ADMIN_PASSWORD=guclu-bir-yonetici-parolasi

# --- Web (nginx) ---
# VIRTUAL_HOST=alanadiniz.com   # İsterseniz reverse proxy (Traefik vb.) için
